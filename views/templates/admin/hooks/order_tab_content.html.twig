{#
  DZ Carrier Manager — Order Detail Tab Content Hook
#}
<div class="tab-pane fade" id="dzcm-carrier-tracking" role="tabpanel" aria-labelledby="dzcm-carrier-tracking-tab">
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-header-title m-0">
                <i class="material-icons">local_shipping</i>
                {{ 'Carrier Tracking Information'|trans({}, 'Modules.Dzcarriermanager.Admin') }}
            </h3>
            {% if parcel %}
                <span class="dzcm-status-badge dzcm-phase-{{ statusPhase }}">
                    {{ statusLabel }}
                </span>
            {% endif %}
        </div>
        <div class="card-body">
            {% if parcel %}
                <div class="row mb-4">
                    <div class="col-md-6">
                        <p><strong>{{ 'Tracking Number'|trans({}, 'Modules.Dzcarriermanager.Admin') }}:</strong>
                            {% if parcel.tracking %}
                                <code>{{ parcel.tracking }}</code>
                            {% else %}
                                <span class="text-muted">{{ 'Not yet dispatched'|trans({}, 'Modules.Dzcarriermanager.Admin') }}</span>
                            {% endif %}
                        </p>
                        <p><strong>{{ 'Carrier'|trans({}, 'Admin.Global') }}:</strong> {{ parcel.carrier_name|default('Guepex') }}</p>
                        <p><strong>{{ 'Delivery Type'|trans({}, 'Modules.Dzcarriermanager.Admin') }}:</strong> {{ parcel.delivery_type|default('home') }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>{{ 'Destination'|trans({}, 'Modules.Dzcarriermanager.Admin') }}:</strong> {{ parcel.wilaya_name|default(order.wilaya) }}{% if parcel.commune_name %}, {{ parcel.commune_name }}{% endif %}</p>
                        <p><strong>{{ 'Delivery Fee'|trans({}, 'Modules.Dzcarriermanager.Admin') }}:</strong> {{ parcel.delivery_fee }} DZD</p>
                        {% if parcel.label_url %}
                            <a href="{{ parcel.label_url }}" target="_blank" class="btn btn-outline-primary btn-sm mt-2">
                                <i class="material-icons" style="font-size:16px">print</i> {{ 'Download Label'|trans({}, 'Modules.Dzcarriermanager.Admin') }}
                            </a>
                        {% endif %}
                    </div>
                </div>

                <hr>
                <h4 class="mb-3"><i class="material-icons" style="font-size:18px">timeline</i> {{ 'Status History'|trans({}, 'Modules.Dzcarriermanager.Admin') }}</h4>

                {% if history|length > 0 %}
                    <div class="dzcm-timeline">
                        {% for entry in history %}
                            <div class="dzcm-timeline-item">
                                <div class="dzcm-timeline-dot"></div>
                                <div class="dzcm-timeline-content">
                                    <strong>{{ entry.status }}</strong>
                                    {% if entry.reason %}
                                        <br><small class="text-muted">{{ entry.reason }}</small>
                                    {% endif %}
                                    <br><small class="text-muted">{{ entry.occurred_at }}</small>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted">{{ 'No status updates received yet.'|trans({}, 'Modules.Dzcarriermanager.Admin') }}</p>
                {% endif %}
            {% else %}
                <div class="alert alert-info mb-0">
                    <p class="mb-0">{{ 'This order has not been confirmed for carrier dispatch yet.'|trans({}, 'Modules.Dzcarriermanager.Admin') }}</p>
                </div>
            {% endif %}
        </div>
        <div class="card-footer text-end">
            <a href="{{ path('ps_dzcarriermanager_parcel_view', {orderId: orderId}) }}" class="btn btn-outline-secondary btn-sm">
                <i class="material-icons" style="font-size:14px">open_in_new</i> {{ 'Open in DZ Carrier Manager'|trans({}, 'Modules.Dzcarriermanager.Admin') }}
            </a>
        </div>
    </div>
</div>
